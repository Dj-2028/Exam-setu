# ─── App ───
ENV=dev                           # dev | staging | production
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:8000

# ─── Database (Neon Postgres) ───
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname?sslmode=require

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── Firebase ───
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT={}        # JSON string of service account key

# ─── Object Storage (Cloudflare R2) ───
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=examsetu-scans

# ─── AI Providers ───
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL_VISION=gemini-2.0-flash
GEMINI_MODEL_TEXT=gemini-2.0-flash
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
AI_SUGGESTION_TIMEOUT=30
AI_HANDWRITING_TIMEOUT=30

# ─── Audit Signing (Ed25519) ───
AUDIT_SIGNING_PRIVATE_KEY=base64-encoded-ed25519-private-key
AUDIT_SIGNING_KEY_ID=key-001

# ─── Observability ───
SENTRY_DSN=
